// schema_local.prisma
generator client {
  provider      = "prisma-client-js"
  output        = "./generated/local-client"
  binaryTargets = ["native", "debian-openssl-3.0.x", "windows"]
}

datasource db {
  provider = "postgresql"
  url      = env("LOCAL_DATABASE_URL")
}

model QuestionPaper {
  id           String   @id @default(uuid())
  classId      String
  subjectId    String?
  examId       String?
  section      String?
  title        String
  fileUrl      String
  
  // New Status & Workflow Fields
  status       String   @default("PENDING_APPROVAL") // PENDING_APPROVAL, APPROVED, REJECTED, PUBLISHED
  scheduledFor DateTime?
  
  // Answer Key Management
  answerKey    String?
  answerKeyUrl String?
  isKeyPublished Boolean @default(false)
  
  // Audit Trail
  uploadedAt   DateTime @default(now())
  uploadedBy   String
  approvedBy   String?
}
