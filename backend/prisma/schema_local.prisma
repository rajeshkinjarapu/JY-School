// schema_local.prisma
generator client {
  provider = "prisma-client-js"
  output   = "./generated/local-client"
}

datasource db {
  provider = "postgresql"
  url      = env("LOCAL_DATABASE_URL")
}

model QuestionPaper {
  id           String   @id @default(uuid())
  classId      String
  subjectId    String?
  examId       String?
  section      String?
  title        String
  fileUrl      String
  answerKey    String?
  answerKeyUrl String?
  uploadedAt   DateTime @default(now())
  uploadedBy   String
}
