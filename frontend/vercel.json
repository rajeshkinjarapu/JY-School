{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://jyschoolcom.duckdns.org/api/$1"
    },
    {
      "source": "/uploads/(.*)",
      "destination": "https://jyschoolcom.duckdns.org/uploads/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
