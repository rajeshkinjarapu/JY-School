{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://oxidize-entangled-spendable.ngrok-free.dev/api/$1"
    },
    {
      "source": "/uploads/(.*)",
      "destination": "https://oxidize-entangled-spendable.ngrok-free.dev/uploads/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
